# Server-side Langdock settings. The starter page runs without them.
# Set real values in your local .env.local.
LANGDOCK_API_KEY=
LANGDOCK_BASE_URL=https://api.langdock.com/openai/eu/v1
LANGDOCK_MODEL=gpt-5.1

# Contact shown in the scraper's User-Agent (team or VHS address, not a private one).
SCRAPER_CONTACT=
